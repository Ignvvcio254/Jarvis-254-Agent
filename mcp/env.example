# MCP Environment Variables
# Copy to .env locally and fill in your values.

# GitHub Personal Access Token (for github-git MCP)
# Scopes needed: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# Mem0 (semantic memory MCP) — optional
MEM0_API_KEY=

# Exa (deep web search) — optional
EXA_API_KEY=

# Firecrawl (web crawling) — optional
FIRECRAWL_API_KEY=

# Vercel (deployment) — optional
VERCEL_TOKEN=

# Sentry (error tracking) — optional
SENTRY_AUTH_TOKEN=
